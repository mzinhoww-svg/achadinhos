  "rotinas": [
    {
      "nome": "Abrir o dia",
      "agente": "Coordenador",
      "quando": "todo dia 06:15",
      "tarefa": "Leia ROTINA.md e o resumo de ontem (resumo_do_dia, metricas 7 dias). Confira ver_pausa e listar_numeros. Se houver chip caído ou pausa, registre o motivo e não siga."
    },
    {
      "nome": "Coleta da manhã",
      "agente": "Garimpeiro",
      "quando": "todo dia 06:30",
      "tarefa": "Para cada nicho ativo (listar_nichos), rode buscar_produtos. Registre um evento coleta.analisada com quantos produtos novos."
    },
    {
      "nome": "Monitor",
      "agente": "Monitor",
      "quando": "a cada 2 h, das 07:00 às 21:00",
      "tarefa": "Rode rodar_monitor. Para cada oferta candidata nova, registre o porquê ela é oferta real (mediana, desconto)."
    },
    {
      "nome": "Arte e copy antes de cada horário",
      "agente": "Diretor de Arte",
      "quando": "07:30, 10:30, 13:30, 16:30, 19:30",
      "tarefa": "Para as candidatas sem peça (listar_ofertas status=candidata), rode renderizar_peca formato=ambos. Avise o Copywriter quando terminar."
    },
    {
      "nome": "Copy antes de cada horário",
      "agente": "Copywriter",
      "quando": "07:40, 10:40, 13:40, 16:40, 19:40",
      "tarefa": "Para as candidatas com peça e sem copy, rode gerar_copy. Leia TOM-DE-VOZ.md antes."
    },
    {
      "nome": "Checagem antes de cada horário",
      "agente": "Coordenador",
      "quando": "07:50, 10:50, 13:50, 16:50, 19:50",
      "tarefa": "Para as candidatas com peça e copy, rode checar_oferta (aprovada é agendada sozinha). Veja os motivos das reprovadas e, se a mesma regra reprova demais, proponha ajuste."
    },
    {
      "nome": "Disparo",
      "agente": "Disparador",
      "quando": "08:00, 11:00, 14:00, 17:00, 20:00",
      "tarefa": "Confira ver_pausa. Rode agendar_disparo executar=true. Registre quantos saíram e para quais grupos."
    },
    {
      "nome": "Fechar o dia",
      "agente": "Coordenador",
      "quando": "todo dia 21:00",
      "tarefa": "Decida as propostas abertas (listar_propostas, decidir_proposta). Depois rode enviar_resumo_whatsapp com até 3 linhas de observação."
    }
  ]
