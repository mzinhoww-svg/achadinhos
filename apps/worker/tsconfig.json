{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "../..",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "declaration": true
  },
  "include": ["src"],
  "exclude": [
    "tests",
    "node_modules",
    "dist",
    "src/executor.ts",
    "src/ports.ts",
    "src/runtime.ts",
    "src/main.ts",
    "src/bin.ts",
    "src/index.ts",
    "src/heartbeat*.ts",
    "src/scheduler.ts",
    "src/memory-store.ts",
    "src/commission-job.ts",
    "src/timeouts.ts",
    "src/config.ts",
    "src/sql/**",
    "src/validation/**"
  ]
}
