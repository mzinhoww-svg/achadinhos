{
  "name": "achadinhos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "dev:worker": "pnpm --filter @achadinhos/worker dev",
    "dev:painel": "pnpm --filter @achadinhos/painel dev",
    "db:gerar": "pnpm --filter @achadinhos/db gerar",
    "empacotar": "node scripts/empacotar.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
