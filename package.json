{
  "name": "achadinhos",
  "private": true,
  "packageManager": "pnpm@10",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:db": "supabase test db --local",
    "test:db:concurrency": "bash supabase/tests/concurrency/claim_next_send.sh",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "pnpm -r --if-present lint",
    "shopee:live-check": "tsx scripts/shopee-live-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
