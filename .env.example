# Variáveis do Achadinhos. Nenhum valor real aqui: os valores ficam nas variáveis de cada app na Vertra
# e nas credenciais do OpenBot. Este arquivo só lista os nomes e para que servem.

# ---------- app "worker" (Vertra) ----------
# Conexão com o Postgres agencia-db (schema achadinhos). Recomendado: usuário próprio (docs/DEPLOY.md).
DATABASE_URL=
# verify-ca (padrão) | verify-full | no-verify | off (só local)
DB_SSL_MODO=verify-ca
# CA, certificado e chave de cliente do banco (PEM em base64), iguais aos da app agencia-worker
DB_SSL_CA_B64=
DB_SSL_CERT_B64=
DB_SSL_KEY_B64=
# Token entre serviços: o mesmo no worker, no painel e nas credenciais do OpenBot (mín. 32 caracteres)
SERVICE_TOKEN=
# Primeiro admin do painel: criado no boot se não houver nenhum. Apague a senha depois do 1º login.
ADMIN_EMAIL=
ADMIN_NOME=Aurimar
ADMIN_SENHA_INICIAL=
# Usadas pelas ferramentas que ainda respondem 501 (já ficam criadas, vazias)
OPENROUTER_API_KEY=
SHOPEE_APP_ID=
SHOPEE_SECRET=
# shopee (piloto) ou fake (ensaio sem a API real)
MARKETPLACE=shopee
# Chamadas por minuto à Open API da Shopee
SHOPEE_POR_MINUTO=30
# Agenda do Monitor (cron, fuso de São Paulo) e quantos produtos consulta um a um por rodada
MONITOR_CRON=0 */2 * * *
MONITOR_MAX_DETALHES=100
# Histórico mínimo para virar oferta
HISTORICO_MIN_AMOSTRAS=4
HISTORICO_MIN_DIAS=3
# Arte (Prompt 3). Sem VERTRA_BLOB_KEY as peças ficam no banco e saem por GET /arquivos/...
VERTRA_BLOB_KEY=
VERTRA_BLOB_PREFIXO=achadinhos/pecas
WORKER_PUBLIC_URL=
ARTE_LIMIAR_CONFIANCA=0.8
WA_GATEWAY_URL=https://wa-gateway-revela.vertraweb.app
# chave do Achadinhos no gateway (EXTRA_API_KEYS lá)
WA_GATEWAY_TOKEN=
WA_GATEWAY_POOL=achadinhos
# token que o gateway manda no webhook (?t=)
WA_WEBHOOK_TOKEN=
PAINEL_PUBLIC_URL=https://achadinhos-painel.vertraweb.app
CICLO_AUTOMATICO=reserva
DISPARO_CRON=* * * * *
LOG_LEVEL=info

# ---------- app "painel" (Vertra) ----------
WORKER_URL=
# SERVICE_TOKEN= (o mesmo do worker)
# Segredo da sessão do painel (mín. 32 caracteres)
AUTH_SECRET=
