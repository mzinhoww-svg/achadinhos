# Variáveis do Achadinhos. Nenhum valor real aqui: os valores ficam nas variáveis de cada app na Vertra
# e nas credenciais do OpenBot. Este arquivo só lista os nomes e para que servem.

# ---------- app "worker" (Vertra) ----------
# Conexão com o Postgres agencia-db (schema achadinhos). Recomendado: usuário próprio (docs/DEPLOY.md).
DATABASE_URL=
# verificar | sem-verificacao | desligado (só local)
DATABASE_SSL=verificar
# Certificado da CA do banco, se a verificação exigir (opcional)
DATABASE_CA=
# Token entre serviços: o mesmo no worker, no painel e nas credenciais do OpenBot (mín. 32 caracteres)
SERVICE_TOKEN=
# Primeiro admin do painel: criado no boot se não houver nenhum. Apague a senha depois do 1º login.
ADMIN_EMAIL=
ADMIN_NOME=Aurimar
ADMIN_SENHA_INICIAL=
# Usadas pelas ferramentas que ainda respondem 501 (já ficam criadas, vazias)
OPENROUTER_API_KEY=
SHOPEE_APP_ID=
SHOPEE_SECRET=
WA_GATEWAY_URL=https://wa-gateway-revela.vertraweb.app
WA_GATEWAY_TOKEN=
LOG_LEVEL=info

# ---------- app "painel" (Vertra) ----------
WORKER_URL=
# SERVICE_TOKEN= (o mesmo do worker)
# Segredo da sessão do painel (mín. 32 caracteres)
AUTH_SECRET=
